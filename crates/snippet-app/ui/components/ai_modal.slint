import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct AIGroupPreview {
    group_name: string,
    reason: string,
    snippet_titles: string,
}

export component AIModal inherits Rectangle {
    in property <bool> is_open: false;
    in property <bool> is_loading: false;
    in property <string> error_msg: "";
    in property <[AIGroupPreview]> suggested_groups: [];

    callback run_ai_grouping();
    callback apply_groups();
    callback close();

    if root.is_open: Rectangle {
        background: #000000.transparentize(40%);

        TouchArea {
            clicked => {
                if !root.is_loading {
                    root.close();
                }
            }
        }

        modal_card := Rectangle {
            width: 540px;
            height: 480px;
            background: Theme.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "✨ AI Snippet Grouping";
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;

                        TouchArea {
                            clicked => {
                                if !root.is_loading {
                                    root.close();
                                }
                            }
                        }

                        Text {
                            text: "✕";
                            font-size: 14px;
                            color: Theme.text_muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: "Analyze all snippets and group them logically using AI.";
                    font-size: 12px;
                    color: Theme.text_muted;
                }

                if root.error_msg != "": Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: Theme.danger.transparentize(85%);
                    border-width: 1px;
                    border-color: Theme.danger;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;

                        Text {
                            text: root.error_msg;
                            font-size: 11px;
                            color: Theme.danger;
                            vertical-alignment: center;
                        }
                    }
                }

                // Results preview or initial trigger
                if root.suggested_groups.length == 0: Rectangle {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: center;
                        spacing: 14px;

                        Text {
                            text: root.is_loading ? "Analyzing snippets with AI..." : "Ready to group your snippets.";
                            font-size: 13px;
                            color: Theme.text_secondary;
                            horizontal-alignment: center;
                        }

                        if !root.is_loading: Rectangle {
                            width: 180px;
                            height: 38px;
                            border-radius: 6px;
                            background: Theme.accent;
                            x: (parent.width - self.width) / 2;

                            TouchArea {
                                clicked => { root.run_ai_grouping(); }
                            }

                            Text {
                                text: "Start AI Grouping";
                                font-size: 12px;
                                font-weight: 600;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if root.suggested_groups.length > 0: ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 8px;

                        for group in root.suggested_groups: Rectangle {
                            border-radius: 6px;
                            background: Theme.surface_elevated;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: group.group_name;
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                    }
                                }

                                Text {
                                    text: group.reason;
                                    font-size: 11px;
                                    color: Theme.text_secondary;
                                }

                                Text {
                                    text: "Snippets: " + group.snippet_titles;
                                    font-size: 10px;
                                    color: Theme.text_muted;
                                }
                            }
                        }
                    }
                }

                // Action buttons when suggestions ready
                if root.suggested_groups.length > 0: HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    cancel_btn := Rectangle {
                        width: 80px;
                        height: 34px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;

                        TouchArea { clicked => { root.close(); } }

                        Text {
                            text: "Cancel";
                            font-size: 12px;
                            color: Theme.text_secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    apply_btn := Rectangle {
                        width: 110px;
                        height: 34px;
                        border-radius: 6px;
                        background: Theme.success;

                        TouchArea {
                            clicked => {
                                root.apply_groups();
                                root.close();
                            }
                        }

                        Text {
                            text: "Apply Groups";
                            font-size: 12px;
                            font-weight: 600;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
