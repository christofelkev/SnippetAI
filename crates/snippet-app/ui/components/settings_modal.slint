import { Theme } from "../theme.slint";
import { LineEdit, ComboBox } from "std-widgets.slint";

export component SettingsModal inherits Rectangle {
    in property <bool> is_open: false;
    in-out property <int> selected_theme: 0;
    in-out property <string> provider: "deepseek";
    in-out property <string> api_key: "";
    in-out property <string> model_override: "";
    in-out property <string> hotkey: "Ctrl+Shift+Space";

    in property <[string]> theme_options: ["Default (Zinc)", "Hacker Red (Persona 5)", "Ocean Blue", "Cyberpunk 2077"];
    in property <[string]> provider_options: ["deepseek", "openai", "anthropic"];

    callback save(int, string, string, string, string);
    callback close();

    if root.is_open: Rectangle {
        background: #000000.transparentize(40%);

        TouchArea {
            // backdrop dismiss
            clicked => { root.close(); }
        }

        modal_card := Rectangle {
            width: 480px;
            height: 460px;
            background: Theme.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Settings";
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text_primary;
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 4px;

                        TouchArea {
                            clicked => { root.close(); }
                        }

                        Text {
                            text: "✕";
                            font-size: 14px;
                            color: Theme.text_muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Theme selection
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "App Theme"; font-size: 12px; color: Theme.text_secondary; }
                    theme_box := ComboBox {
                        model: root.theme_options;
                        current-index: root.selected_theme;
                        selected => {
                            root.selected_theme = self.current-index;
                        }
                    }
                }

                // AI Provider
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "AI Provider"; font-size: 12px; color: Theme.text_secondary; }
                    prov_box := ComboBox {
                        model: root.provider_options;
                        current-value: root.provider;
                        selected => {
                            root.provider = self.current-value;
                        }
                    }
                }

                // API Key
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "API Key"; font-size: 12px; color: Theme.text_secondary; }
                    key_field := LineEdit {
                        text: root.api_key;
                        placeholder-text: "sk-...";
                        input-type: password;
                        edited => { root.api_key = self.text; }
                    }
                }

                // Hotkey
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Global Hotkey (Quick Paste)"; font-size: 12px; color: Theme.text_secondary; }
                    hotkey_field := LineEdit {
                        text: root.hotkey;
                        placeholder-text: "Ctrl+Shift+Space";
                        edited => { root.hotkey = self.text; }
                    }
                }

                // Action buttons
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    cancel_btn := Rectangle {
                        width: 80px;
                        height: 34px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;

                        TouchArea { clicked => { root.close(); } }

                        Text {
                            text: "Cancel";
                            font-size: 12px;
                            color: Theme.text_secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    save_btn := Rectangle {
                        width: 90px;
                        height: 34px;
                        border-radius: 6px;
                        background: Theme.accent;

                        TouchArea {
                            clicked => {
                                root.save(root.selected_theme, root.provider, root.api_key, root.model_override, root.hotkey);
                                root.close();
                            }
                        }

                        Text {
                            text: "Save";
                            font-size: 12px;
                            font-weight: 600;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
