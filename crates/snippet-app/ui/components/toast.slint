import { Theme } from "../theme.slint";

export component Toast inherits Rectangle {
    in-out property <bool> is_visible: false;
    in-out property <string> message: "";
    in-out property <bool> is_error: false;

    height: 40px;
    border-radius: 8px;
    background: root.is_error ? Theme.danger : Theme.surface_elevated;
    border-width: 1px;
    border-color: root.is_error ? Theme.danger : Theme.border;
    opacity: root.is_visible ? 1.0 : 0.0;
    visible: root.opacity > 0.01;

    animate opacity { duration: 250ms; easing: ease-in-out; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;

        Text {
            text: root.is_error ? "⚠️" : "✓";
            font-size: 13px;
            vertical-alignment: center;
        }

        Text {
            text: root.message;
            font-size: 12px;
            font-weight: 600;
            color: root.is_error ? #ffffff : Theme.text_primary;
            vertical-alignment: center;
        }
    }
}
