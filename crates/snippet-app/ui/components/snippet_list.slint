import { Theme } from "../theme.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";

export struct SnippetItem {
    id: string,
    title: string,
    preview: string,
    group_name: string,
    language: string,
}

export component SnippetList inherits Rectangle {
    in property <[SnippetItem]> snippets: [];
    in property <string> selected_id: "";
    in-out property <string> search_query: "";

    callback select_snippet(string);
    callback add_snippet();
    callback open_ai();
    callback open_settings();
    callback search_edited(string);

    background: Theme.surface.transparentize(20%);

    VerticalLayout {
        // Search & Add Bar (Standardized h-14 / 56px with balanced 36px inputs)
        Rectangle {
            height: 56px;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                alignment: center;

                search_input := LineEdit {
                    horizontal-stretch: 1;
                    height: Theme.input_h;
                    placeholder-text: "Search snippets… (Ctrl+K)";
                    text: root.search_query;
                    edited => {
                        root.search_query = self.text;
                        root.search_edited(self.text);
                    }
                }

                add_btn := Rectangle {
                    width: Theme.btn_h_md;
                    height: Theme.btn_h_md;
                    border-radius: Theme.radius_md;
                    background: add_touch.has-hover ? Theme.accent_hover : Theme.accent;

                    add_touch := TouchArea {
                        clicked => { root.add_snippet(); }
                    }

                    Text {
                        text: "+";
                        font-size: 18px;
                        font-weight: 700;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Snippet cards scroll view
        ScrollView {
            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 2px;

                if root.snippets.length == 0: Rectangle {
                    height: 140px;
                    Text {
                        text: "No snippets found";
                        color: Theme.text_muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                for item in root.snippets: Rectangle {
                    height: 74px;
                    border-radius: Theme.radius_md;
                    background: root.selected_id == item.id ?
                        Theme.surface_elevated :
                        (card_touch.has-hover ? Theme.surface_elevated.transparentize(40%) : Colors.transparent);
                    border-width: root.selected_id == item.id ? 1px : 0px;
                    border-color: root.selected_id == item.id ? Theme.border : Colors.transparent;

                    card_touch := TouchArea {
                        clicked => { root.select_snippet(item.id); }
                    }

                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 4px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: item.title == "" ? "Untitled Snippet" : item.title;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                                color: root.selected_id == item.id ? Theme.text_primary : Theme.text_primary.transparentize(15%);
                                vertical-alignment: center;
                            }

                            if item.group_name != "": Rectangle {
                                height: 18px;
                                border-radius: Theme.radius_sm;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;

                                    Text {
                                        text: item.group_name;
                                        font-size: 10px;
                                        font-weight: 600;
                                        letter-spacing: 0.5px;
                                        color: Theme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Text {
                            text: item.preview;
                            font-size: 12px;
                            overflow: elide;
                            color: Theme.text_muted;
                        }
                    }
                }
            }
        }

        // Bottom action bar (Standardized h-12 / 48px with sleek ghost buttons)
        Rectangle {
            height: 48px;
            background: Theme.surface;

            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: space-between;
                spacing: 8px;

                ai_btn := Rectangle {
                    height: Theme.btn_h_sm;
                    border-radius: Theme.radius_md;
                    background: ai_touch.has-hover ? Theme.surface_elevated : Colors.transparent;

                    ai_touch := TouchArea {
                        clicked => { root.open_ai(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;

                        Text {
                            text: "✨";
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "AI Grouping";
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.text_secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                settings_btn := Rectangle {
                    width: Theme.btn_h_sm;
                    height: Theme.btn_h_sm;
                    border-radius: Theme.radius_md;
                    background: set_touch.has-hover ? Theme.surface_elevated : Colors.transparent;

                    set_touch := TouchArea {
                        clicked => { root.open_settings(); }
                    }

                    Text {
                        text: "⚙";
                        font-size: 14px;
                        color: Theme.text_muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
